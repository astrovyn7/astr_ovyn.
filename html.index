  <!-- HOW WE WORK -->
  <section class="section process-section" id="process">
    <div class="container">

      <div class="section-heading reveal">
        <div class="eyebrow">
          <span class="eyebrow-number">05</span>
          OUR APPROACH
        </div>
        <h2>
          FROM QUESTION<br>
          TO <span class="gradient-text">DISCOVERY.</span>
        </h2>
        <p class="section-description">
          Every meaningful project starts with a question. We aim to
          follow a process that turns curiosity into structured learning.
        </p>
      </div>

      <div class="process-grid">

        <div class="process-step reveal">
          <div class="process-number">01</div>
          <h3>Question</h3>
          <p>Identify an interesting problem or scientific question.</p>
        </div>

        <div class="process-step reveal delay-1">
          <div class="process-number">02</div>
          <h3>Research</h3>
          <p>Study reliable sources, theories, and existing solutions.</p>
        </div>

        <div class="process-step reveal delay-2">
          <div class="process-number">03</div>
          <h3>Experiment</h3>
          <p>Test ideas through suitable models, simulations, or experiments.</p>
        </div>

        <div class="process-step reveal delay-3">
          <div class="process-number">04</div>
          <h3>Document</h3>
          <p>Record findings, evaluate results, and share what we learn.</p>
        </div>

      </div>
    </div>
  </section>

